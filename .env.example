# Varijable za Vercel (Project → Settings → Environment Variables, okruženje Production).
# Nazivi moraju biti točno ovakvi. Nakon dodavanja ili izmjene treba ponovno objaviti stranicu (Redeploy).

# --- Resend (https://resend.com): slanje upita iz forme ---
# OBAVEZNO u produkciji. API ključ iz Resenda (API Keys), počinje s "re_".
# Bez ključa forma u produkciji javlja tehničku grešku; u developmentu se upit samo ispiše u log servera.
RESEND_API_KEY=
# Pošiljatelj: adresa na domeni verificiranoj u Resendu (Domains), npr. "Divine Healing <upit@vasa-domena.hr>".
# Prazno = testna adresa onboarding@resend.dev, koja šalje samo na e-mail vlasnika Resend računa.
UPIT_EMAIL_FROM=
# Kamo stižu upiti. Neobavezno (prazno = sanjazrig@gmail.com).
UPIT_EMAIL_TO=sanjazrig@gmail.com

# --- Domena ---
# Javna adresa stranice za canonical, sitemap i Open Graph, npr. https://www.vasa-domena.hr (bez / na kraju).
# Prazno = produkcijska adresa projekta na Vercelu, a lokalno http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
